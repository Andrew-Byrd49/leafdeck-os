new file mode 100644
index 0000000..6588171
--- /dev/null
+++ b/leafdeck.h
@@ -0,0 +1,101 @@
+#ifndef CG_LEAFDECK_H
+#define CG_LEAFDECK_H
+
+/*
+ * Leafdeck OS: the real windows of programs, inside Leafdeck's own window frames.
+ *
+ * Leafdeck (an Electron app, "the shell") is cage's full-screen client, and it draws every window frame itself. Once
+ * it connects to the control socket (its path is in LEAFDECK_COMPOSITOR) and says which process it is, every toplevel
+ * from any other process is a "native" window: cage doesn't make it full screen, but tells Leafdeck about it and
+ * shows it where Leafdeck says, cropped to the frame's content. The native windows are drawn above Leafdeck's main
+ * window; wherever Leafdeck's UI should be in front of one (another window over it, a menu), Leafdeck lists that
+ * area as a "cover" and cage draws Leafdeck's own pixels there again, above the native window. Leafdeck's other
+ * windows (the lock screen, a file picker) are drawn above everything.
+ */
+
+#include <stdbool.h>
+#include <sys/types.h>
+#include <wayland-server-core.h>
+#include <wlr/util/box.h>
+#include <xkbcommon/xkbcommon.h>
+
+struct cg_server;
+struct cg_view;
+struct wlr_surface;
+struct wlr_scene_node;
+struct wlr_scene_tree;
+
+#define LD_MAX_COVERS 48
+
+struct cg_native {
+	struct cg_view *view;
+	struct wl_list link; // cg_leafdeck::natives
+	uint32_t id;
+	struct wlr_scene_tree *group;  // the window, its covers and its popups, in this order
+	struct wlr_scene_tree *covers; // Leafdeck's pixels over the window where its UI is in front
+	struct wlr_scene_tree *popups; // the window's menus, above its covers
+	struct wlr_box rect;	       // where Leafdeck shows it (layout coordinates)
+	bool placed;
+	bool fullscreen;
+	int asked_w, asked_h; // the size last asked of the program
+	int told_w, told_h;   // the size last told to Leafdeck
+	struct wlr_box cover[LD_MAX_COVERS];
+	int ncover;
+	struct wl_listener commit;
+	struct wl_listener set_title;
+	struct wl_listener set_app_id;
+	struct wl_listener request_configure; // X11
+	struct wl_listener request_move;
+	struct wl_listener request_resize;
+	struct wl_listener request_maximize;
+	struct wl_listener request_minimize;
+	struct wl_listener set_decorations; // X11
+	bool ssd; // Leafdeck draws its title bar (the program asked for server-side decorations)
+};
+
+void leafdeck_init(struct cg_server *server, const char *wayland_socket);
+void leafdeck_finish(struct cg_server *server);
+
+/* Is this surface a native window's (a client other than Leafdeck, while Leafdeck is connected)? */
+bool leafdeck_surface_is_native(struct cg_server *server, struct wlr_surface *surface);
+bool leafdeck_pid_is_native(struct cg_server *server, pid_t pid);
+
+/* Buttons on a screen's Leafdeck window hold the pointer there until they're all let go. leafdeck_pointer_button is
+ * called after the seat has the button; true when the hold just ended. leafdeck_held_motion sends the motion to the held
+ * window (true) or leaves it to the usual hit test (false). */
+bool leafdeck_pointer_button(struct cg_server *server, bool pressed);
+bool leafdeck_held_motion(struct cg_server *server, uint32_t time_msec, double lx, double ly);
+
+/* A Leafdeck window that fills one screen (the `screen` command): that screen's box in layout coordinates. False for
+ * any other window, or when its screen isn't on. */
+bool leafdeck_screen_box(struct cg_view *view, struct wlr_box *box);
+
+/* Where a mapping view's scene tree goes (and makes it native when it should be). */
+struct wlr_scene_tree *leafdeck_view_parent(struct cg_view *view, struct wlr_surface *surface);
+void leafdeck_view_mapped(struct cg_view *view);
+void leafdeck_view_unmapped(struct cg_view *view);
+void leafdeck_focus_changed(struct cg_view *view);
+void leafdeck_fullscreen_requested(struct cg_view *view, bool fullscreen);
+
+/* A cover was hit: the input goes to Leafdeck's main window. NULL when `node` isn't a cover's. */
+struct cg_view *leafdeck_cover_hit(struct cg_server *server, struct wlr_scene_node *node, double lx, double ly,
+				   struct wlr_surface **surface, double *sx, double *sy);
+
+/* Leafdeck's keys (Super, Alt+Tab) bring the keyboard back to Leafdeck from a native window. */
+void leafdeck_key(struct cg_server *server, const xkb_keysym_t *syms, int nsyms, uint32_t modifiers, bool pressed);
+
+/* An xdg decoration was negotiated: server-side means Leafdeck's title bar, client-side the program's own. */
+void leafdeck_decoration(struct cg_view *view, bool server_side);
+
+/* A program moving or resizing its window from its own title bar: the pointer goes to Leafdeck's frame until the
+ * button is let go. True when the event was taken. */
+bool leafdeck_grab_motion(struct cg_server *server, double lx, double ly);
+bool leafdeck_grab_button(struct cg_server *server, bool pressed);
+
+/* A pointer came or went: the mouse settings Leafdeck sent (`pointer`) go on every mouse, and Leafdeck hears how many. */
+void leafdeck_pointers_changed(struct cg_server *server);
+
+/* The scene tree a native view's popups go in. */
+struct wlr_scene_tree *leafdeck_popup_parent(struct cg_view *view);
+
+#endif
