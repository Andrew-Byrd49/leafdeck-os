+/* The output a touchscreen belongs to: udev's WL_OUTPUT, which wlroots doesn't pass on for libinput devices. */
+static const char *
+touch_output_name(struct wlr_touch *wlr_touch)
+{
+	if (wlr_touch->output_name) {
+		return wlr_touch->output_name;
+	}
+	if (wlr_input_device_is_libinput(&wlr_touch->base)) {
+		return libinput_device_get_output_name(wlr_libinput_get_device_handle(&wlr_touch->base));
+	}
+	return NULL;
+}
+
+/* Touchscreens report positions in their panel's own orientation: turn them with the output they're on (a panel mounted
+ * upside down, like the Yoga Book 9's top one, or one rotated in the display settings). x and y are 0..1. */
+static void
+touch_to_output_orientation(struct cg_seat *seat, struct wlr_touch *wlr_touch, double *x, double *y)
+{
+	const char *name = touch_output_name(wlr_touch);
+	if (!name) {
+		return;
+	}
+
+	struct cg_output *output;
+	wl_list_for_each (output, &seat->server->outputs, link) {
+		if (strcmp(name, output->wlr_output->name) == 0) {
+			struct wlr_fbox point = {.x = *x, .y = *y}, turned;
+			wlr_fbox_transform(&turned, &point, output->wlr_output->transform, 1, 1);
+			*x = turned.x;
+			*y = turned.y;
+			return;
+		}
+	}
+}
+
+/* Touchscreens can appear before their outputs (at startup) and outputs come and go, so map them again on every
+ * layout change. */
+void
+seat_map_touch_devices(struct cg_seat *seat)
+{
+	struct cg_touch *touch;
+	wl_list_for_each (touch, &seat->touch, link) {
+		const char *name = touch_output_name(touch->touch);
+		if (name) {
+			map_input_device_to_output(seat, &touch->touch->base, name);
+		}
+	}
+}
