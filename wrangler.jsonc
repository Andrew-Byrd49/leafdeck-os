{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leafdeck",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  // Sync connected calendars every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Leafdeck app updates (served at /api/updates/*).
  // Note images and voice memos (served at /api/media/*).
  "r2_buckets": [
    { "binding": "UPDATES", "bucket_name": "leafdeck-updates" },
    { "binding": "MEDIA", "bucket_name": "leafdeck-media" }
  ],
  // Live updates for companion devices: one WebSocket hub (see src/live.js).
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "Live" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leafdeck-db",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      // `wrangler dev` keeps using its own local copy (your test data), never the live database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Required for connected accounts: `npx wrangler secret put TOKEN_KEY` (32 random bytes, base64).
  // Google Calendar: `npx wrangler secret put GOOGLE_CLIENT_ID` and `GOOGLE_CLIENT_SECRET`.
  // Optional: `npx wrangler secret put API_TOKEN` to require a token on every /api request.
  // Recommended: put the whole Worker behind Cloudflare Access (Zero Trust) instead.
}
