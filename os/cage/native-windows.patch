diff --git a/leafdeck.c b/leafdeck.c
new file mode 100644
index 0000000..7976b2d
--- /dev/null
+++ b/leafdeck.c
@@ -0,0 +1,1400 @@
+/*
+ * Leafdeck OS: the real windows of programs, inside Leafdeck's own window frames. See leafdeck.h.
+ *
+ * The control socket speaks lines. Leafdeck sends commands, separated by spaces:
+ *   shell <pid>                  Leafdeck's process: from now on other clients' toplevels are native windows
+ *   main <title>                 Leafdeck's main window is the one with this title (Leafdeck sets it for a moment)
+ *   screen <title> <output>      the Leafdeck window with this title fills that screen (connector name) and only it,
+ *                                drawn at its scale, below the programs' windows like the main one (- : any again);
+ *                                a window that isn't there yet gets it as it opens (so it never covers every screen)
+ *   mainscreen <output>          the same for the main window (- : all screens again)
+ *   screenfocus <output>         keyboard focus to the Leafdeck window of that screen
+ *   list                         announce every native window again (after Leafdeck restarts)
+ *   place <id> <x> <y> <w> <h>   show it there, that size (Leafdeck's main-window coordinates)
+ *   hide <id>
+ *   cover <id> [<x> <y> <w> <h>]...   the areas where Leafdeck's UI is in front of it
+ *   order <id>...                stacking, bottom to top
+ *   focus <id>                   keyboard focus (0: Leafdeck)
+ *   close <id>
+ *   fullscreen <id> <0|1>
+ *   maximized <id> <0|1>         Leafdeck maximized or restored its frame (the program's own button follows)
+ *   pointer <adaptive|flat> <speed>   every mouse (not a touchpad): libinput's acceleration profile and speed, -100..100
+ *                                (Settings → Mouse). Kept for mice plugged in later, and while Leafdeck is away.
+ * and cage sends events, separated by tabs:
+ *   new <id> <parent> <pid> <w> <h> <min_w> <min_h> <app_id> <title>
+ *   title <id> <title>    appid <id> <app_id>    size <id> <w> <h>    fullscreen <id> <0|1>
+ *   focus <id>            gone <id>              main <ok|missing>     screen <output> <ok|pending>
+ *   deco <id> <ssd|csd>   whether Leafdeck draws the title bar (ssd) or the program does (csd)
+ *   grab <id> <move|resize> <edges> <x> <y>    the program's own title bar or border was pressed: Leafdeck's frame
+ *   drag <id> <x> <y>     moves or resizes with the pointer (main-window coordinates) until
+ *   dragend <id> <x> <y>
+ *   state <id> <maximize|unmaximize|minimize>  the program asked (a double click on its title bar, its buttons)
+ *   pointer <mice>        after `pointer`, and as mice come and go: how many mice have the settings
+ */
+#define _GNU_SOURCE
+
+#include "config.h"
+
+#include <errno.h>
+#include <stdarg.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+#include <libinput.h>
+#include <wayland-server-core.h>
+#include <wlr/backend/libinput.h>
+#include <wlr/types/wlr_compositor.h>
+#include <wlr/types/wlr_keyboard.h>
+#include <wlr/types/wlr_output_layout.h>
+#include <wlr/types/wlr_pointer.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/types/wlr_xdg_shell.h>
+#include <wlr/util/log.h>
+#if CAGE_HAS_XWAYLAND
+#include <wlr/xwayland.h>
+#endif
+
+#include "leafdeck.h"
+#include "output.h"
+#include "seat.h"
+#include "server.h"
+#include "view.h"
+#include "xdg_shell.h"
+#if CAGE_HAS_XWAYLAND
+#include "xwayland.h"
+#endif
+
+struct cg_leafdeck {
+	struct cg_server *server;
+	char path[256];
+	int listen_fd;
+	struct wl_event_source *listen_src;
+	int client_fd;
+	struct wl_event_source *client_src;
+	char in[65536];
+	size_t inlen;
+	pid_t shell_pid; // 0: no Leafdeck connected, cage behaves as it always has
+	struct cg_view *main;
+	struct wl_listener main_commit;
+	struct wl_event_source *main_frame; // frame callbacks for Leafdeck even when programs cover it
+	struct wlr_scene_tree *shell_top; // Leafdeck's other windows, above the native ones
+	struct wl_list natives;		  // cg_native::link
+	uint32_t next_id;
+	uint32_t last_focus; // the focus Leafdeck was last told about
+	struct cg_native *grab; // moving or resizing with the pointer (a program's own title bar)
+	int cover_marker;    // the covers' node data points here
+	struct {
+		char title[96];
+		char output[32];
+	} pending[8]; // `screen` for windows that haven't opened yet
+	struct cg_view *held; // a screen's window a button was pressed on: it has the pointer until the buttons are up
+	struct {
+		bool set; // Leafdeck sent `pointer` (until then libinput's defaults: adaptive, speed 0)
+		bool flat;
+		double speed; // -1..1
+	} pointer;
+};
+
+static struct cg_leafdeck *ld_of(struct cg_server *server)
+{
+	return server->leafdeck;
+}
+
+/* ---------------- telling Leafdeck ---------------- */
+
+static void send_line(struct cg_leafdeck *ld, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void
+send_line(struct cg_leafdeck *ld, const char *fmt, ...)
+{
+	if (ld->client_fd < 0) {
+		return;
+	}
+	char buf[2048];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(buf, sizeof(buf) - 1, fmt, ap);
+	va_end(ap);
+	if (n < 0) {
+		return;
+	}
+	if (n > (int) sizeof(buf) - 2) {
+		n = sizeof(buf) - 2;
+	}
+	buf[n++] = '\n';
+	size_t off = 0;
+	while (off < (size_t) n) {
+		ssize_t w = send(ld->client_fd, buf + off, n - off, MSG_NOSIGNAL);
+		if (w < 0) {
+			if (errno == EINTR) {
+				continue;
+			}
+			return; // Leafdeck isn't reading (or is gone): it asks for the list again when it's back
+		}
+		off += w;
+	}
+}
+
+/* ---------------- the mouse (Settings → Mouse) ---------------- */
+
+/* A mouse: a libinput pointer with acceleration that isn't a touchpad (those keep libinput's touchpad defaults). */
+static struct libinput_device *
+mouse_of(struct wlr_pointer *pointer)
+{
+	if (!wlr_input_device_is_libinput(&pointer->base)) {
+		return NULL;
+	}
+	struct libinput_device *dev = wlr_libinput_get_device_handle(&pointer->base);
+	if (!dev || libinput_device_config_tap_get_finger_count(dev) > 0 || !libinput_device_config_accel_is_available(dev)) {
+		return NULL;
+	}
+	return dev;
+}
+
+/* Puts the settings on every mouse there is (a new one too) and tells Leafdeck how many. */
+static void
+apply_pointer(struct cg_leafdeck *ld)
+{
+	int mice = 0;
+	struct cg_pointer *p;
+	wl_list_for_each (p, &ld->server->seat->pointers, link) {
+		struct libinput_device *dev = mouse_of(p->pointer);
+		if (!dev) {
+			continue;
+		}
+		mice++;
+		if (!ld->pointer.set) {
+			continue;
+		}
+		enum libinput_config_accel_profile want =
+			ld->pointer.flat ? LIBINPUT_CONFIG_ACCEL_PROFILE_FLAT : LIBINPUT_CONFIG_ACCEL_PROFILE_ADAPTIVE;
+		if (libinput_device_config_accel_get_profiles(dev) & want) {
+			libinput_device_config_accel_set_profile(dev, want);
+		}
+		libinput_device_config_accel_set_speed(dev, ld->pointer.speed);
+	}
+	send_line(ld, "pointer\t%d", mice);
+}
+
+void
+leafdeck_pointers_changed(struct cg_server *server)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	if (ld) {
+		apply_pointer(ld);
+	}
+}
+
+/* Titles and app ids go in a tab-separated line: no tabs or line breaks in them. */
+static const char *
+clean(const char *s, char *out, size_t size)
+{
+	size_t i = 0;
+	for (; s && *s && i + 1 < size; s++) {
+		out[i++] = (*s == '\t' || *s == '\n' || *s == '\r') ? ' ' : *s;
+	}
+	out[i] = 0;
+	return out;
+}
+
+static const char *
+view_app_id(struct cg_view *view)
+{
+#if CAGE_HAS_XWAYLAND
+	if (view->type == CAGE_XWAYLAND_VIEW) {
+		return xwayland_view_from_view(view)->xwayland_surface->class;
+	}
+#endif
+	return ((struct cg_xdg_shell_view *) view)->xdg_toplevel->app_id;
+}
+
+static const char *
+view_title(struct cg_view *view)
+{
+	return view->impl->get_title(view);
+}
+
+static pid_t
+view_pid(struct cg_view *view, struct wlr_surface *surface)
+{
+#if CAGE_HAS_XWAYLAND
+	if (view->type == CAGE_XWAYLAND_VIEW) {
+		return xwayland_view_from_view(view)->xwayland_surface->pid;
+	}
+#endif
+	pid_t pid = 0;
+	if (surface && surface->resource) {
+		wl_client_get_credentials(wl_resource_get_client(surface->resource), &pid, NULL, NULL);
+	}
+	return pid;
+}
+
+/* The window's own size: its geometry, without client-side shadows. */
+static struct wlr_box
+view_geometry(struct cg_view *view)
+{
+	struct wlr_box box = {0};
+#if CAGE_HAS_XWAYLAND
+	if (view->type == CAGE_XWAYLAND_VIEW) {
+		struct wlr_xwayland_surface *xs = xwayland_view_from_view(view)->xwayland_surface;
+		if (xs->surface) {
+			box.width = xs->surface->current.width;
+			box.height = xs->surface->current.height;
+		}
+		return box;
+	}
+#endif
+	struct wlr_xdg_surface *xdg = ((struct cg_xdg_shell_view *) view)->xdg_toplevel->base;
+	box = xdg->geometry;
+	if (box.width == 0 || box.height == 0) {
+		box.x = box.y = 0;
+		box.width = xdg->surface->current.width;
+		box.height = xdg->surface->current.height;
+	}
+	return box;
+}
+
+static uint32_t
+parent_id(struct cg_view *view)
+{
+	struct cg_leafdeck *ld = ld_of(view->server);
+	struct cg_native *n;
+	wl_list_for_each (n, &ld->natives, link) {
+		if (n->view != view && view_is_transient_for(view, n->view)) {
+			return n->id;
+		}
+	}
+	return 0;
+}
+
+static void
+announce(struct cg_leafdeck *ld, struct cg_native *n)
+{
+	char app[256], title[512];
+	struct wlr_box g = view_geometry(n->view);
+	int min_w = 0, min_h = 0;
+	if (n->view->type == CAGE_XDG_SHELL_VIEW) {
+		struct wlr_xdg_toplevel *t = ((struct cg_xdg_shell_view *) n->view)->xdg_toplevel;
+		min_w = t->current.min_width;
+		min_h = t->current.min_height;
+	}
+	n->told_w = g.width;
+	n->told_h = g.height;
+	// First whether it draws its own title bar, so Leafdeck makes the right frame for it.
+	send_line(ld, "deco\t%u\t%s", n->id, n->ssd ? "ssd" : "csd");
+	send_line(ld, "new\t%u\t%u\t%d\t%d\t%d\t%d\t%d\t%s\t%s", n->id, parent_id(n->view),
+		  (int) view_pid(n->view, n->view->wlr_surface), g.width, g.height, min_w, min_h,
+		  clean(view_app_id(n->view), app, sizeof(app)), clean(view_title(n->view), title, sizeof(title)));
+}
+
+/* ---------------- covers ---------------- */
+
+struct cover_ctx {
+	struct cg_native *n;
+	struct wlr_box rect;
+};
+
+static void
+cover_from_buffer(struct wlr_scene_buffer *sb, int bx, int by, void *data)
+{
+	struct cover_ctx *c = data;
+	if (!sb->buffer || sb->transform != WL_OUTPUT_TRANSFORM_NORMAL) {
+		return;
+	}
+	int dw = sb->dst_width ? sb->dst_width : sb->buffer->width;
+	int dh = sb->dst_height ? sb->dst_height : sb->buffer->height;
+	struct wlr_box dest = {bx, by, dw, dh}, part;
+	if (dw <= 0 || dh <= 0 || !wlr_box_intersection(&part, &dest, &c->rect)) {
+		return;
+	}
+	struct wlr_fbox src = sb->src_box;
+	if (wlr_fbox_empty(&src)) {
+		src = (struct wlr_fbox){0, 0, sb->buffer->width, sb->buffer->height};
+	}
+	double kx = src.width / dw, ky = src.height / dh;
+	struct wlr_scene_buffer *node = wlr_scene_buffer_create(c->n->covers, sb->buffer);
+	if (!node) {
+		return;
+	}
+	struct wlr_fbox from = {
+		.x = src.x + (part.x - bx) * kx,
+		.y = src.y + (part.y - by) * ky,
+		.width = part.width * kx,
+		.height = part.height * ky,
+	};
+	wlr_scene_buffer_set_source_box(node, &from);
+	wlr_scene_buffer_set_dest_size(node, part.width, part.height);
+	wlr_scene_node_set_position(&node->node, part.x, part.y);
+}
+
+/* Draws Leafdeck's current pixels over the native window wherever Leafdeck's UI is in front of it. */
+static void
+sync_covers(struct cg_leafdeck *ld, struct cg_native *n)
+{
+	struct wlr_scene_node *child, *tmp;
+	wl_list_for_each_safe (child, tmp, &n->covers->children, link) {
+		wlr_scene_node_destroy(child);
+	}
+	if (!ld->main || !ld->main->scene_tree || !n->placed) {
+		return;
+	}
+	for (int i = 0; i < n->ncover; i++) {
+		struct cover_ctx c = {n, n->cover[i]};
+		wlr_scene_node_for_each_buffer(&ld->main->scene_tree->node, cover_from_buffer, &c);
+	}
+}
+
+/* The scene only answers a surface's frame callbacks while it's visible. A program in full screen covers all of Leafdeck,
+ * whose page would then stop drawing, and so stop telling cage where the program goes (it never got out of full screen
+ * again). So Leafdeck's main window gets its frame callbacks anyway, about 60 times a second while it draws. */
+static int
+main_frame_done(void *data)
+{
+	struct cg_leafdeck *ld = data;
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (ld->main && ld->main->wlr_surface) {
+		wlr_surface_send_frame_done(ld->main->wlr_surface, &now);
+	}
+	// And each screen's own Leafdeck window.
+	struct cg_view *v;
+	wl_list_for_each (v, &ld->server->views, link) {
+		if (v != ld->main && v->ld_screen[0] && v->wlr_surface) {
+			wlr_surface_send_frame_done(v->wlr_surface, &now);
+		}
+	}
+	return 0;
+}
+
+static void
+frame_soon(struct cg_leafdeck *ld)
+{
+	if (!ld->main_frame) {
+		ld->main_frame = wl_event_loop_add_timer(wl_display_get_event_loop(ld->server->wl_display), main_frame_done, ld);
+	}
+	if (ld->main_frame) {
+		wl_event_source_timer_update(ld->main_frame, 16);
+	}
+}
+
+static void
+handle_main_commit(struct wl_listener *listener, void *data)
+{
+	struct cg_leafdeck *ld = wl_container_of(listener, ld, main_commit);
+	frame_soon(ld);
+	struct cg_native *n;
+	wl_list_for_each (n, &ld->natives, link) {
+		if (n->ncover) {
+			sync_covers(ld, n);
+		}
+	}
+}
+
+static void
+set_main(struct cg_leafdeck *ld, struct cg_view *view)
+{
+	if (ld->main) {
+		wl_list_remove(&ld->main_commit.link);
+	}
+	ld->main = view;
+	if (!view) {
+		return;
+	}
+	ld->main_commit.notify = handle_main_commit;
+	wl_signal_add(&view->wlr_surface->events.commit, &ld->main_commit);
+	// Leafdeck's other windows (a lock screen, a picker) go above the native ones.
+	struct cg_view *v;
+	wl_list_for_each (v, &ld->server->views, link) {
+		if (v != view && !v->native && !v->ld_screen[0] && v->scene_tree &&
+		    v->scene_tree->node.parent == ld->server->shell_layer) {
+			wlr_scene_node_reparent(&v->scene_tree->node, ld->shell_top);
+		}
+	}
+}
+
+/* ---------------- screens ---------------- */
+
+/* Leafdeck can draw each screen as a window of its own (one surface per screen: each at its screen's scale, and what
+ * changes on one screen doesn't make the others redraw). Such a window fills its screen and sits at the bottom, like
+ * the main window, which can be one of them. */
+
+static struct cg_output *
+output_named(struct cg_server *server, const char *name)
+{
+	struct cg_output *o;
+	wl_list_for_each (o, &server->outputs, link) {
+		if (!strcmp(o->wlr_output->name, name)) {
+			return o;
+		}
+	}
+	return NULL;
+}
+
+static void
+handle_screen_commit(struct wl_listener *listener, void *data);
+
+static void
+screen_listen(struct cg_view *view, struct wlr_surface *surface)
+{
+	if (view->ld_listening || !surface) {
+		return;
+	}
+	view->ld_commit.notify = handle_screen_commit;
+	wl_signal_add(&surface->events.commit, &view->ld_commit);
+	view->ld_listening = true;
+}
+
+/* A window `screen` named before it opened: it gets its screen now (its first configure is that screen's size). */
+static void
+adopt_pending(struct cg_leafdeck *ld, struct cg_view *view)
+{
+	const char *t = view_title(view);
+	if (view->ld_screen[0] || view->native || !t) {
+		return;
+	}
+	for (size_t i = 0; i < sizeof(ld->pending) / sizeof(*ld->pending); i++) {
+		if (ld->pending[i].title[0] && !strcmp(ld->pending[i].title, t)) {
+			snprintf(view->ld_screen, sizeof(view->ld_screen), "%s", ld->pending[i].output);
+			ld->pending[i].title[0] = 0;
+			return;
+		}
+	}
+}
+
+bool
+leafdeck_screen_box(struct cg_view *view, struct wlr_box *box)
+{
+	struct cg_leafdeck *ld = ld_of(view->server);
+	if (ld && ld->shell_pid > 0) {
+		adopt_pending(ld, view);
+	}
+	if (!view->ld_screen[0]) {
+		return false;
+	}
+	struct cg_output *o = output_named(view->server, view->ld_screen);
+	if (!o) {
+		return false;
+	}
+	wlr_output_layout_get_box(view->server->output_layout, o->wlr_output, box);
+	return !wlr_box_empty(box);
+}
+
+static void
+handle_screen_commit(struct wl_listener *listener, void *data)
+{
+	struct cg_view *view = wl_container_of(listener, view, ld_commit);
+	frame_soon(ld_of(view->server));
+}
+
+static void
+unpin(struct cg_view *view)
+{
+	view->ld_screen[0] = 0;
+	if (view->ld_listening) {
+		wl_list_remove(&view->ld_commit.link);
+		view->ld_listening = false;
+	}
+}
+
+static void
+pin(struct cg_leafdeck *ld, struct cg_view *view, const char *output)
+{
+	screen_listen(view, view->wlr_surface);
+	snprintf(view->ld_screen, sizeof(view->ld_screen), "%s", output);
+	if (view->scene_tree) {
+		wlr_scene_node_reparent(&view->scene_tree->node, ld->server->shell_layer);
+	}
+	view_position(view);
+}
+
+bool
+leafdeck_pointer_button(struct cg_server *server, bool pressed)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	if (!ld) {
+		return false;
+	}
+	struct wlr_seat *seat = server->seat->seat;
+	if (pressed) {
+		struct wlr_surface *focused = seat->pointer_state.focused_surface;
+		if (ld->held || !focused || ld->shell_pid <= 0) {
+			return false;
+		}
+		struct cg_view *v;
+		wl_list_for_each (v, &server->views, link) {
+			if (v->ld_screen[0] && v->wlr_surface == focused) {
+				ld->held = v;
+				break;
+			}
+		}
+		return false;
+	}
+	if (ld->held && seat->pointer_state.button_count == 0) {
+		ld->held = NULL;
+		return true;
+	}
+	return false;
+}
+
+bool
+leafdeck_held_motion(struct cg_server *server, uint32_t time_msec, double lx, double ly)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	struct cg_view *v = ld ? ld->held : NULL;
+	if (!v || !v->wlr_surface) {
+		return false;
+	}
+	struct wlr_seat *seat = server->seat->seat;
+	double sx = lx - v->lx, sy = ly - v->ly;
+	if (seat->pointer_state.focused_surface != v->wlr_surface) {
+		wlr_seat_pointer_notify_enter(seat, v->wlr_surface, sx, sy);
+	}
+	wlr_seat_pointer_notify_motion(seat, time_msec, sx, sy);
+	return true;
+}
+
+/* ---------------- placing ---------------- */
+
+static struct cg_native *
+find(struct cg_leafdeck *ld, uint32_t id)
+{
+	struct cg_native *n;
+	wl_list_for_each (n, &ld->natives, link) {
+		if (n->id == id) {
+			return n;
+		}
+	}
+	return NULL;
+}
+
+static void
+ask_size(struct cg_native *n, int w, int h)
+{
+	struct cg_view *view = n->view;
+#if CAGE_HAS_XWAYLAND
+	if (view->type == CAGE_XWAYLAND_VIEW) {
+		struct wlr_xwayland_surface *xs = xwayland_view_from_view(view)->xwayland_surface;
+		wlr_xwayland_surface_configure(xs, n->rect.x, n->rect.y, w, h);
+		n->asked_w = w;
+		n->asked_h = h;
+		return;
+	}
+#endif
+	if (w == n->asked_w && h == n->asked_h) {
+		return;
+	}
+	n->asked_w = w;
+	n->asked_h = h;
+	wlr_xdg_toplevel_set_size(((struct cg_xdg_shell_view *) view)->xdg_toplevel, w, h);
+}
+
+/* Puts the window's surface so its own area (not its shadows) fills the rectangle, cropped to it. */
+static void
+position(struct cg_native *n)
+{
+	struct cg_view *view = n->view;
+	if (!view->scene_tree) {
+		return;
+	}
+	struct wlr_box g = view_geometry(view);
+	view->lx = n->rect.x - g.x;
+	view->ly = n->rect.y - g.y;
+	wlr_scene_node_set_position(&view->scene_tree->node, view->lx, view->ly);
+	wlr_scene_node_set_position(&n->popups->node, view->lx, view->ly);
+	struct wlr_box clip = {g.x, g.y, n->rect.width, n->rect.height};
+	wlr_scene_subsurface_tree_set_clip(&view->scene_tree->node, &clip);
+}
+
+static void
+place(struct cg_leafdeck *ld, struct cg_native *n, int x, int y, int w, int h)
+{
+	if (w < 1 || h < 1) {
+		return;
+	}
+	int ox = ld->main ? ld->main->lx : 0, oy = ld->main ? ld->main->ly : 0;
+	n->rect = (struct wlr_box){x + ox, y + oy, w, h};
+	n->placed = true;
+	ask_size(n, w, h);
+	position(n);
+	wlr_scene_node_set_enabled(&n->group->node, true);
+	sync_covers(ld, n);
+}
+
+static void
+hide(struct cg_native *n)
+{
+	wlr_scene_node_set_enabled(&n->group->node, false);
+}
+
+/* ---------------- native views ---------------- */
+
+static void
+native_commit(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, commit);
+	struct cg_leafdeck *ld = ld_of(n->view->server);
+	struct wlr_box g = view_geometry(n->view);
+	if (g.width != n->told_w || g.height != n->told_h) {
+		n->told_w = g.width;
+		n->told_h = g.height;
+		send_line(ld, "size\t%u\t%d\t%d", n->id, g.width, g.height);
+	}
+	if (n->placed) {
+		position(n); // the geometry's offset can change with the size
+	}
+}
+
+static void
+native_title(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, set_title);
+	char title[512];
+	send_line(ld_of(n->view->server), "title\t%u\t%s", n->id, clean(view_title(n->view), title, sizeof(title)));
+}
+
+static void
+native_app_id(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, set_app_id);
+	char app[256];
+	send_line(ld_of(n->view->server), "appid\t%u\t%s", n->id, clean(view_app_id(n->view), app, sizeof(app)));
+}
+
+#if CAGE_HAS_XWAYLAND
+/* An X11 program asking for a size or place: before Leafdeck has placed it, it gets what it asked for (Leafdeck
+ * then makes a frame that size); after, it keeps Leafdeck's rectangle. */
+static void
+native_request_configure(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, request_configure);
+	struct wlr_xwayland_surface_configure_event *ev = data;
+	if (n->placed) {
+		wlr_xwayland_surface_configure(ev->surface, n->rect.x, n->rect.y, n->rect.width, n->rect.height);
+	} else {
+		wlr_xwayland_surface_configure(ev->surface, ev->x, ev->y, ev->width, ev->height);
+	}
+}
+#endif
+
+/* ---------------- a program's own title bar ---------------- */
+
+static void
+main_coords(struct cg_leafdeck *ld, double lx, double ly, int *x, int *y)
+{
+	*x = (int) (lx - (ld->main ? ld->main->lx : 0));
+	*y = (int) (ly - (ld->main ? ld->main->ly : 0));
+}
+
+static void
+start_grab(struct cg_native *n, const char *kind, uint32_t edges)
+{
+	struct cg_server *server = n->view->server;
+	struct cg_leafdeck *ld = ld_of(server);
+	// Only while a button is down (a press on the title bar), and only when Leafdeck can move the frame.
+	if (!ld->main || n->view->native == NULL || server->seat->seat->pointer_state.button_count == 0) {
+		return;
+	}
+	ld->grab = n;
+	wlr_seat_pointer_clear_focus(server->seat->seat);
+	int x, y;
+	main_coords(ld, server->seat->cursor->x, server->seat->cursor->y, &x, &y);
+	send_line(ld, "grab\t%u\t%s\t%u\t%d\t%d", n->id, kind, edges, x, y);
+}
+
+bool
+leafdeck_grab_motion(struct cg_server *server, double lx, double ly)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	if (!ld || !ld->grab) {
+		return false;
+	}
+	int x, y;
+	main_coords(ld, lx, ly, &x, &y);
+	send_line(ld, "drag\t%u\t%d\t%d", ld->grab->id, x, y);
+	return true;
+}
+
+bool
+leafdeck_grab_button(struct cg_server *server, bool pressed)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	if (!ld || !ld->grab) {
+		return false;
+	}
+	if (!pressed && server->seat->seat->pointer_state.button_count == 0) {
+		int x, y;
+		main_coords(ld, server->seat->cursor->x, server->seat->cursor->y, &x, &y);
+		send_line(ld, "dragend\t%u\t%d\t%d", ld->grab->id, x, y);
+		ld->grab = NULL;
+	}
+	return true;
+}
+
+static void
+native_request_move(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, request_move);
+	start_grab(n, "move", 0);
+}
+
+static void
+native_request_resize(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, request_resize);
+	uint32_t edges = 0;
+#if CAGE_HAS_XWAYLAND
+	if (n->view->type == CAGE_XWAYLAND_VIEW) {
+		edges = ((struct wlr_xwayland_resize_event *) data)->edges;
+	} else
+#endif
+		edges = ((struct wlr_xdg_toplevel_resize_event *) data)->edges;
+	start_grab(n, "resize", edges);
+}
+
+static void
+native_request_maximize(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, request_maximize);
+	bool on = true;
+#if CAGE_HAS_XWAYLAND
+	if (n->view->type == CAGE_XWAYLAND_VIEW) {
+		struct wlr_xwayland_surface *xs = xwayland_view_from_view(n->view)->xwayland_surface;
+		on = !(xs->maximized_horz && xs->maximized_vert);
+	} else
+#endif
+	{
+		struct wlr_xdg_toplevel *t = ((struct cg_xdg_shell_view *) n->view)->xdg_toplevel;
+		on = t->requested.maximized;
+		if (t->base->initialized) {
+			wlr_xdg_surface_schedule_configure(t->base); // the protocol wants an answer either way
+		}
+	}
+	send_line(ld_of(n->view->server), "state\t%u\t%s", n->id, on ? "maximize" : "unmaximize");
+}
+
+static void
+native_request_minimize(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, request_minimize);
+#if CAGE_HAS_XWAYLAND
+	if (n->view->type == CAGE_XWAYLAND_VIEW && !((struct wlr_xwayland_minimize_event *) data)->minimize) {
+		return;
+	}
+#endif
+	send_line(ld_of(n->view->server), "state\t%u\tminimize", n->id);
+}
+
+#if CAGE_HAS_XWAYLAND
+/* An X11 program without the window manager's frame (_MOTIF_WM_HINTS: Spotify, Chrome) draws its own title bar. */
+static bool
+x11_ssd(struct wlr_xwayland_surface *xs)
+{
+	return xs->decorations == WLR_XWAYLAND_SURFACE_DECORATIONS_ALL;
+}
+
+static void
+native_set_decorations(struct wl_listener *listener, void *data)
+{
+	struct cg_native *n = wl_container_of(listener, n, set_decorations);
+	bool ssd = x11_ssd(xwayland_view_from_view(n->view)->xwayland_surface);
+	if (ssd != n->ssd) {
+		n->ssd = ssd;
+		send_line(ld_of(n->view->server), "deco\t%u\t%s", n->id, ssd ? "ssd" : "csd");
+	}
+}
+#endif
+
+void
+leafdeck_decoration(struct cg_view *view, bool server_side)
+{
+	view->ssd = server_side;
+	if (view->native && view->native->ssd != server_side) {
+		view->native->ssd = server_side;
+		send_line(ld_of(view->server), "deco\t%u\t%s", view->native->id, server_side ? "ssd" : "csd");
+	}
+}
+
+bool
+leafdeck_pid_is_native(struct cg_server *server, pid_t pid)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	return ld && ld->shell_pid > 0 && pid > 0 && pid != ld->shell_pid;
+}
+
+bool
+leafdeck_surface_is_native(struct cg_server *server, struct wlr_surface *surface)
+{
+	pid_t pid = 0;
+	if (!surface || !surface->resource) {
+		return false;
+	}
+	wl_client_get_credentials(wl_resource_get_client(surface->resource), &pid, NULL, NULL);
+	return leafdeck_pid_is_native(server, pid);
+}
+
+struct wlr_scene_tree *
+leafdeck_view_parent(struct cg_view *view, struct wlr_surface *surface)
+{
+	struct cg_server *server = view->server;
+	struct cg_leafdeck *ld = ld_of(server);
+	if (!ld || !leafdeck_pid_is_native(server, view_pid(view, surface))) {
+		// Leafdeck's own windows: the main one and each screen's at the bottom, the rest above the native windows.
+		if (ld && ld->shell_pid > 0) {
+			adopt_pending(ld, view);
+		}
+		if (ld && view->ld_screen[0]) {
+			screen_listen(view, surface);
+			return server->shell_layer;
+		}
+		return (ld && ld->main) ? ld->shell_top : server->shell_layer;
+	}
+#if CAGE_HAS_XWAYLAND
+	if (view->type == CAGE_XWAYLAND_VIEW && !xwayland_view_should_manage(view)) {
+		// An X11 menu or tooltip: where the program puts it, above everything native.
+		view->native_overlay = true;
+		return server->native_layer;
+	}
+#endif
+	struct cg_native *n = calloc(1, sizeof(*n));
+	if (!n) {
+		return server->shell_layer;
+	}
+	n->view = view;
+	n->id = ++ld->next_id;
+	n->group = wlr_scene_tree_create(server->native_layer);
+	n->group->node.data = view;
+	n->covers = wlr_scene_tree_create(n->group);
+	n->covers->node.data = &ld->cover_marker;
+	n->popups = wlr_scene_tree_create(n->group);
+	wlr_scene_node_set_enabled(&n->group->node, false); // until Leafdeck places it
+	view->native = n;
+	wl_list_insert(ld->natives.prev, &n->link);
+	return n->group;
+}
+
+void
+leafdeck_view_mapped(struct cg_view *view)
+{
+	struct cg_native *n = view->native;
+	if (view->native_overlay) {
+		wlr_scene_node_raise_to_top(&view->scene_tree->node);
+		return;
+	}
+	if (!n) {
+		return;
+	}
+	// The window goes below its covers and popups.
+	wlr_scene_node_lower_to_bottom(&view->scene_tree->node);
+	n->commit.notify = native_commit;
+	wl_signal_add(&view->wlr_surface->events.commit, &n->commit);
+	wl_list_init(&n->request_configure.link);
+#if CAGE_HAS_XWAYLAND
+	if (view->type == CAGE_XWAYLAND_VIEW) {
+		struct wlr_xwayland_surface *xs = xwayland_view_from_view(view)->xwayland_surface;
+		n->set_title.notify = native_title;
+		wl_signal_add(&xs->events.set_title, &n->set_title);
+		n->set_app_id.notify = native_app_id;
+		wl_signal_add(&xs->events.set_class, &n->set_app_id);
+		n->request_configure.notify = native_request_configure;
+		wl_signal_add(&xs->events.request_configure, &n->request_configure);
+		n->request_move.notify = native_request_move;
+		wl_signal_add(&xs->events.request_move, &n->request_move);
+		n->request_resize.notify = native_request_resize;
+		wl_signal_add(&xs->events.request_resize, &n->request_resize);
+		n->request_maximize.notify = native_request_maximize;
+		wl_signal_add(&xs->events.request_maximize, &n->request_maximize);
+		n->request_minimize.notify = native_request_minimize;
+		wl_signal_add(&xs->events.request_minimize, &n->request_minimize);
+		n->set_decorations.notify = native_set_decorations;
+		wl_signal_add(&xs->events.set_decorations, &n->set_decorations);
+		n->ssd = x11_ssd(xs);
+	} else
+#endif
+	{
+		struct wlr_xdg_toplevel *t = ((struct cg_xdg_shell_view *) view)->xdg_toplevel;
+		n->set_title.notify = native_title;
+		wl_signal_add(&t->events.set_title, &n->set_title);
+		n->set_app_id.notify = native_app_id;
+		wl_signal_add(&t->events.set_app_id, &n->set_app_id);
+		n->request_move.notify = native_request_move;
+		wl_signal_add(&t->events.request_move, &n->request_move);
+		n->request_resize.notify = native_request_resize;
+		wl_signal_add(&t->events.request_resize, &n->request_resize);
+		n->request_maximize.notify = native_request_maximize;
+		wl_signal_add(&t->events.request_maximize, &n->request_maximize);
+		n->request_minimize.notify = native_request_minimize;
+		wl_signal_add(&t->events.request_minimize, &n->request_minimize);
+		wl_list_init(&n->set_decorations.link);
+		n->ssd = view->ssd;
+	}
+	announce(ld_of(view->server), n);
+}
+
+void
+leafdeck_view_unmapped(struct cg_view *view)
+{
+	struct cg_leafdeck *ld = ld_of(view->server);
+	if (!ld) {
+		return;
+	}
+	if (ld->main == view) {
+		set_main(ld, NULL);
+		send_line(ld, "main\tmissing");
+	}
+	unpin(view);
+	if (ld->held == view) {
+		ld->held = NULL;
+	}
+	struct cg_native *n = view->native;
+	if (!n) {
+		return;
+	}
+	send_line(ld, "gone\t%u", n->id);
+	if (ld->last_focus == n->id) {
+		ld->last_focus = 0;
+	}
+	wl_list_remove(&n->commit.link);
+	wl_list_remove(&n->set_title.link);
+	wl_list_remove(&n->set_app_id.link);
+	wl_list_remove(&n->request_configure.link);
+	wl_list_remove(&n->request_move.link);
+	wl_list_remove(&n->request_resize.link);
+	wl_list_remove(&n->request_maximize.link);
+	wl_list_remove(&n->request_minimize.link);
+	wl_list_remove(&n->set_decorations.link);
+	if (ld->grab == n) {
+		ld->grab = NULL;
+	}
+	wl_list_remove(&n->link);
+	wlr_scene_node_destroy(&n->group->node); // with the window's surface tree in it
+	view->scene_tree = NULL;
+	view->native = NULL;
+	free(n);
+}
+
+struct wlr_scene_tree *
+leafdeck_popup_parent(struct cg_view *view)
+{
+	return view->native ? view->native->popups : view->scene_tree;
+}
+
+void
+leafdeck_focus_changed(struct cg_view *view)
+{
+	struct cg_leafdeck *ld = ld_of(view->server);
+	if (!ld || ld->shell_pid <= 0 || view->native_overlay) {
+		return;
+	}
+	uint32_t id = view->native ? view->native->id : 0;
+	if (id != ld->last_focus) {
+		ld->last_focus = id;
+		send_line(ld, "focus\t%u", id);
+	}
+}
+
+void
+leafdeck_fullscreen_requested(struct cg_view *view, bool fullscreen)
+{
+	if (view->native) {
+		send_line(ld_of(view->server), "fullscreen\t%u\t%d", view->native->id, fullscreen ? 1 : 0);
+	}
+}
+
+struct cg_view *
+leafdeck_cover_hit(struct cg_server *server, struct wlr_scene_node *node, double lx, double ly,
+		   struct wlr_surface **surface, double *sx, double *sy)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	if (!ld) {
+		return NULL;
+	}
+	bool cover = false;
+	for (struct wlr_scene_node *p = node; p; p = p->parent ? &p->parent->node : NULL) {
+		if (p->data == &ld->cover_marker) {
+			cover = true;
+			break;
+		}
+	}
+	if (!cover || !ld->main || !ld->main->scene_tree) {
+		return NULL;
+	}
+	struct wlr_scene_node *hit = wlr_scene_node_at(&ld->main->scene_tree->node, lx, ly, sx, sy);
+	if (!hit || hit->type != WLR_SCENE_NODE_BUFFER) {
+		return NULL;
+	}
+	struct wlr_scene_surface *ss = wlr_scene_surface_try_from_buffer(wlr_scene_buffer_from_node(hit));
+	if (!ss) {
+		return NULL;
+	}
+	*surface = ss->surface;
+	return ld->main;
+}
+
+void
+leafdeck_key(struct cg_server *server, const xkb_keysym_t *syms, int nsyms, uint32_t modifiers, bool pressed)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	if (!ld || !ld->main || !pressed) {
+		return;
+	}
+	struct cg_view *focus = seat_get_focus(server->seat);
+	if (!focus || !focus->native) {
+		return;
+	}
+	for (int i = 0; i < nsyms; i++) {
+		bool super = syms[i] == XKB_KEY_Super_L || syms[i] == XKB_KEY_Super_R;
+		bool alt_tab = syms[i] == XKB_KEY_Tab && (modifiers & WLR_MODIFIER_ALT);
+		if (super || alt_tab) {
+			seat_set_focus(server->seat, ld->main);
+			return;
+		}
+	}
+}
+
+/* ---------------- the control socket ---------------- */
+
+static void drop_client(struct cg_leafdeck *ld);
+
+static int
+to_int(const char *s, int *out)
+{
+	if (!s) {
+		return 0;
+	}
+	char *end;
+	long v = strtol(s, &end, 10);
+	if (*end || end == s) {
+		return 0;
+	}
+	*out = (int) v;
+	return 1;
+}
+
+static void
+command(struct cg_leafdeck *ld, char *line)
+{
+	char *argv[2 + 4 * LD_MAX_COVERS + 4];
+	int argc = 0;
+	for (char *tok = strtok(line, " \t"); tok && argc < (int) (sizeof(argv) / sizeof(*argv)); tok = strtok(NULL, " \t")) {
+		argv[argc++] = tok;
+	}
+	if (argc == 0) {
+		return;
+	}
+	struct cg_server *server = ld->server;
+	const char *cmd = argv[0];
+	int id = 0;
+	struct cg_native *n = argc > 1 && to_int(argv[1], &id) ? find(ld, (uint32_t) id) : NULL;
+
+	if (!strcmp(cmd, "shell") && argc == 2) {
+		int pid;
+		if (to_int(argv[1], &pid) && pid > 0) {
+			ld->shell_pid = pid;
+			wlr_log(WLR_INFO, "Leafdeck: the shell is process %d", pid);
+		}
+	} else if (!strcmp(cmd, "main") && argc >= 2) {
+		// The rest of the line is the title (it can't hold spaces here: Leafdeck sends a single word).
+		struct cg_view *v, *found = NULL;
+		wl_list_for_each (v, &server->views, link) {
+			const char *t = view_title(v);
+			if (!v->native && t && !strcmp(t, argv[1])) {
+				found = v;
+			}
+		}
+		set_main(ld, found);
+		send_line(ld, "main\t%s", found ? "ok" : "missing");
+	} else if (!strcmp(cmd, "screen") && argc == 3) {
+		struct cg_view *v, *found = NULL;
+		wl_list_for_each (v, &server->views, link) {
+			const char *t = view_title(v);
+			if (!v->native && !v->native_overlay && t && !strcmp(t, argv[1])) {
+				found = v;
+			}
+		}
+		if (found && !strcmp(argv[2], "-")) {
+			unpin(found);
+			view_position(found);
+		} else if (found) {
+			pin(ld, found, argv[2]);
+		} else {
+			// Not open yet: it gets its screen as it opens. The oldest wish makes room.
+			size_t n = sizeof(ld->pending) / sizeof(*ld->pending), slot = n - 1;
+			for (size_t i = 0; i < n; i++) {
+				if (!ld->pending[i].title[0] || !strcmp(ld->pending[i].title, argv[1])) {
+					slot = i;
+					break;
+				}
+			}
+			snprintf(ld->pending[slot].title, sizeof(ld->pending[slot].title), "%s", argv[1]);
+			snprintf(ld->pending[slot].output, sizeof(ld->pending[slot].output), "%s", argv[2]);
+		}
+		send_line(ld, "screen\t%s\t%s", argv[2], found ? "ok" : "pending");
+	} else if (!strcmp(cmd, "mainscreen") && argc == 2) {
+		if (ld->main && !strcmp(argv[1], "-")) {
+			unpin(ld->main);
+			view_position(ld->main);
+		} else if (ld->main) {
+			pin(ld, ld->main, argv[1]);
+		}
+		send_line(ld, "screen\t%s\t%s", argv[1], ld->main ? "ok" : "missing"); // also tells Leafdeck this cage pins
+	} else if (!strcmp(cmd, "screenfocus") && argc == 2) {
+		struct cg_view *v;
+		wl_list_for_each (v, &server->views, link) {
+			if (!strcmp(v->ld_screen, argv[1])) {
+				seat_set_focus(server->seat, v);
+				break;
+			}
+		}
+	} else if (!strcmp(cmd, "list")) {
+		struct cg_native *each;
+		wl_list_for_each (each, &ld->natives, link) {
+			announce(ld, each);
+		}
+		struct cg_view *f = seat_get_focus(server->seat);
+		ld->last_focus = f && f->native ? f->native->id : 0;
+		send_line(ld, "focus\t%u", ld->last_focus);
+	} else if (!strcmp(cmd, "place") && n && argc == 6) {
+		int x, y, w, h;
+		if (to_int(argv[2], &x) && to_int(argv[3], &y) && to_int(argv[4], &w) && to_int(argv[5], &h)) {
+			place(ld, n, x, y, w, h);
+		}
+	} else if (!strcmp(cmd, "hide") && n) {
+		hide(n);
+	} else if (!strcmp(cmd, "cover") && n) {
+		int ox = ld->main ? ld->main->lx : 0, oy = ld->main ? ld->main->ly : 0;
+		n->ncover = 0;
+		for (int i = 2; i + 3 < argc && n->ncover < LD_MAX_COVERS; i += 4) {
+			struct wlr_box b;
+			if (to_int(argv[i], &b.x) && to_int(argv[i + 1], &b.y) && to_int(argv[i + 2], &b.width) &&
+			    to_int(argv[i + 3], &b.height) && b.width > 0 && b.height > 0) {
+				b.x += ox;
+				b.y += oy;
+				n->cover[n->ncover++] = b;
+			}
+		}
+		sync_covers(ld, n);
+	} else if (!strcmp(cmd, "order")) {
+		for (int i = 1; i < argc; i++) {
+			int oid;
+			struct cg_native *o = to_int(argv[i], &oid) ? find(ld, (uint32_t) oid) : NULL;
+			if (o) {
+				wlr_scene_node_raise_to_top(&o->group->node);
+			}
+		}
+		// X11 menus stay above every window.
+		struct cg_view *v;
+		wl_list_for_each (v, &server->views, link) {
+			if (v->native_overlay && v->scene_tree) {
+				wlr_scene_node_raise_to_top(&v->scene_tree->node);
+			}
+		}
+	} else if (!strcmp(cmd, "focus") && argc == 2) {
+		if (id == 0 && ld->main) {
+			seat_set_focus(server->seat, ld->main);
+		} else if (n) {
+			seat_set_focus(server->seat, n->view);
+		}
+	} else if (!strcmp(cmd, "close") && n) {
+		n->view->impl->close(n->view);
+	} else if (!strcmp(cmd, "maximized") && n && argc == 3) {
+		bool on = !strcmp(argv[2], "1");
+#if CAGE_HAS_XWAYLAND
+		if (n->view->type == CAGE_XWAYLAND_VIEW) {
+			wlr_xwayland_surface_set_maximized(xwayland_view_from_view(n->view)->xwayland_surface, on, on);
+		} else
+#endif
+			wlr_xdg_toplevel_set_maximized(((struct cg_xdg_shell_view *) n->view)->xdg_toplevel, on);
+	} else if (!strcmp(cmd, "fullscreen") && n && argc == 3) {
+		bool on = !strcmp(argv[2], "1");
+		n->fullscreen = on;
+#if CAGE_HAS_XWAYLAND
+		if (n->view->type == CAGE_XWAYLAND_VIEW) {
+			wlr_xwayland_surface_set_fullscreen(xwayland_view_from_view(n->view)->xwayland_surface, on);
+		} else
+#endif
+			wlr_xdg_toplevel_set_fullscreen(((struct cg_xdg_shell_view *) n->view)->xdg_toplevel, on);
+	} else if (!strcmp(cmd, "pointer") && argc == 3) {
+		int speed;
+		if ((!strcmp(argv[1], "flat") || !strcmp(argv[1], "adaptive")) && to_int(argv[2], &speed)) {
+			ld->pointer.set = true;
+			ld->pointer.flat = !strcmp(argv[1], "flat");
+			ld->pointer.speed = (speed < -100 ? -100 : speed > 100 ? 100 : speed) / 100.0;
+			apply_pointer(ld);
+		}
+	} else {
+		wlr_log(WLR_DEBUG, "Leafdeck: unknown command %s", cmd);
+	}
+}
+
+static int
+handle_client(int fd, uint32_t mask, void *data)
+{
+	struct cg_leafdeck *ld = data;
+	if (mask & (WL_EVENT_HANGUP | WL_EVENT_ERROR)) {
+		drop_client(ld);
+		return 0;
+	}
+	ssize_t r = recv(fd, ld->in + ld->inlen, sizeof(ld->in) - 1 - ld->inlen, 0);
+	if (r <= 0) {
+		if (r < 0 && (errno == EAGAIN || errno == EINTR)) {
+			return 0;
+		}
+		drop_client(ld);
+		return 0;
+	}
+	ld->inlen += r;
+	ld->in[ld->inlen] = 0;
+	char *start = ld->in, *nl;
+	while ((nl = memchr(start, '\n', ld->in + ld->inlen - start))) {
+		*nl = 0;
+		command(ld, start);
+		if (ld->client_fd < 0) {
+			return 0;
+		}
+		start = nl + 1;
+	}
+	ld->inlen -= start - ld->in;
+	memmove(ld->in, start, ld->inlen);
+	if (ld->inlen >= sizeof(ld->in) - 1) {
+		ld->inlen = 0; // a line that long is nonsense
+	}
+	return 0;
+}
+
+/* Leafdeck went away (it's restarting): its native windows wait, hidden, until it's back and places them again. */
+static void
+drop_client(struct cg_leafdeck *ld)
+{
+	if (ld->client_src) {
+		wl_event_source_remove(ld->client_src);
+		ld->client_src = NULL;
+	}
+	if (ld->client_fd >= 0) {
+		close(ld->client_fd);
+		ld->client_fd = -1;
+	}
+	ld->inlen = 0;
+	ld->shell_pid = 0;
+	set_main(ld, NULL);
+	memset(ld->pending, 0, sizeof(ld->pending));
+	ld->held = NULL;
+	struct cg_view *v;
+	wl_list_for_each (v, &ld->server->views, link) {
+		if (v->ld_screen[0]) {
+			unpin(v);
+			view_position(v);
+		}
+	}
+	struct cg_native *n;
+	wl_list_for_each (n, &ld->natives, link) {
+		n->placed = false;
+		n->ncover = 0;
+		hide(n);
+		sync_covers(ld, n);
+	}
+	// Until Leafdeck is back, its windows are ordinary ones again.
+	struct wlr_scene_node *child, *tmp;
+	wl_list_for_each_safe (child, tmp, &ld->shell_top->children, link) {
+		wlr_scene_node_reparent(child, ld->server->shell_layer);
+	}
+}
+
+static int
+handle_listen(int fd, uint32_t mask, void *data)
+{
+	struct cg_leafdeck *ld = data;
+	int c = accept4(fd, NULL, NULL, SOCK_CLOEXEC | SOCK_NONBLOCK);
+	if (c < 0) {
+		return 0;
+	}
+	// Only this account (the socket's folder is private anyway).
+	struct ucred cred;
+	socklen_t len = sizeof(cred);
+	if (getsockopt(c, SOL_SOCKET, SO_PEERCRED, &cred, &len) < 0 || cred.uid != getuid()) {
+		close(c);
+		return 0;
+	}
+	drop_client(ld); // one Leafdeck at a time: the newest
+	ld->client_fd = c;
+	ld->client_src = wl_event_loop_add_fd(wl_display_get_event_loop(ld->server->wl_display), c, WL_EVENT_READABLE,
+					      handle_client, ld);
+	return 0;
+}
+
+void
+leafdeck_init(struct cg_server *server, const char *wayland_socket)
+{
+	struct cg_leafdeck *ld = calloc(1, sizeof(*ld));
+	if (!ld) {
+		return;
+	}
+	ld->server = server;
+	ld->listen_fd = ld->client_fd = -1;
+	wl_list_init(&ld->natives);
+	ld->shell_top = wlr_scene_tree_create(&server->scene->tree);
+	server->leafdeck = ld;
+
+	const char *dir = getenv("XDG_RUNTIME_DIR");
+	if (!dir || !wayland_socket) {
+		return;
+	}
+	snprintf(ld->path, sizeof(ld->path), "%s/%s.leafdeck", dir, wayland_socket);
+	int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+	struct sockaddr_un addr = {.sun_family = AF_UNIX};
+	size_t len = strlen(ld->path);
+	if (len >= sizeof(addr.sun_path)) {
+		wlr_log(WLR_ERROR, "Leafdeck: the control socket's path is too long: %s", ld->path);
+		if (fd >= 0) {
+			close(fd);
+		}
+		return;
+	}
+	memcpy(addr.sun_path, ld->path, len + 1);
+	unlink(ld->path);
+	if (fd < 0 || bind(fd, (struct sockaddr *) &addr, sizeof(addr)) < 0 || listen(fd, 2) < 0) {
+		wlr_log_errno(WLR_ERROR, "Leafdeck: no control socket at %s", ld->path);
+		if (fd >= 0) {
+			close(fd);
+		}
+		return;
+	}
+	chmod(ld->path, 0600);
+	ld->listen_fd = fd;
+	ld->listen_src = wl_event_loop_add_fd(wl_display_get_event_loop(server->wl_display), fd, WL_EVENT_READABLE,
+					      handle_listen, ld);
+	setenv("LEAFDECK_COMPOSITOR", ld->path, true);
+	wlr_log(WLR_INFO, "Leafdeck: control socket %s", ld->path);
+}
+
+void
+leafdeck_finish(struct cg_server *server)
+{
+	struct cg_leafdeck *ld = ld_of(server);
+	if (!ld) {
+		return;
+	}
+	// The sockets go; the state stays for the windows that unmap while the display shuts down.
+	if (ld->client_src) {
+		wl_event_source_remove(ld->client_src);
+		ld->client_src = NULL;
+	}
+	if (ld->client_fd >= 0) {
+		close(ld->client_fd);
+		ld->client_fd = -1;
+	}
+	if (ld->listen_src) {
+		wl_event_source_remove(ld->listen_src);
+		ld->listen_src = NULL;
+	}
+	if (ld->listen_fd >= 0) {
+		close(ld->listen_fd);
+		ld->listen_fd = -1;
+		unlink(ld->path);
+	}
+}
