[Desktop Entry]
Type=Application
Name=Leafdeck
Comment=Open web links, pictures, folders and files in Leafdeck
Exec=leafdeck-open %U
Icon=leafdeck
NoDisplay=true
Terminal=false
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;application/xhtml+xml;image/png;image/jpeg;image/gif;image/webp;image/avif;image/bmp;image/svg+xml;image/x-icon;image/vnd.microsoft.icon;inode/directory;application/pdf;text/plain;
